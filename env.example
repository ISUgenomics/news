# Copy to a dotenv file at the repo root and fill in. The real file is gitignored and
# readable only by the service user. config.yaml and sources.yaml reference these by
# name as ${VAR}; nothing here is ever committed with a value.
#
# Named env.example rather than the conventional dotted name because this machine's
# permission rules deny writes to that path.

# changedetection.io RSS token (referenced by sources.yaml -> changedetection.url)
CD_TOKEN=

# SMTP credentials for the relay named in config.yaml, if it requires auth
SMTP_USER=
SMTP_PASSWORD=

# Only needed when llm.provider is anthropic-api. The claude-cli, codex-cli and
# local providers use credentials the CLI or the Ollama server already holds.
ANTHROPIC_API_KEY=
