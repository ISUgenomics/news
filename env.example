# A fallback. On macOS the keychain is the better place, because the value is then
# not in a file at all:
#
#     security add-generic-password -s topic-brief -a CD_TOKEN -w
#     (omit -w's argument and it prompts, so the secret stays out of your shell history)
#
# `brief` reads the process environment, then a dotenv file, then the keychain, with
# later winning. So a keychain entry beats a stale export or an old file left on disk.
#
# Use this file when there is no keychain — a Linux VM, a container. Copy it to a
# dotenv file at the repo root and fill in; that file is gitignored. config.yaml and
# sources.yaml reference these by name as ${VAR}; nothing here is ever committed with
# a value.
#
# Named env.example rather than the conventional dotted name because this machine's
# permission rules deny writes to that path.

# changedetection.io RSS token (referenced by sources.yaml -> changedetection.url)
CD_TOKEN=

# SMTP credentials for the relay named in config.yaml, if it requires auth
SMTP_USER=
SMTP_PASSWORD=

# Only needed when llm.provider is anthropic-api. The claude-cli, codex-cli and
# local providers use credentials the CLI or the Ollama server already holds.
ANTHROPIC_API_KEY=
